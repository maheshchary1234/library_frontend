# ─────────────────────────────────────────────────────
#  LumenAi Frontend — Environment Variables Template
#  Copy to .env.local for local dev
#  Set on Vercel dashboard for production
# ─────────────────────────────────────────────────────

# Local development (Spring Boot runs on 8080)
VITE_API_URL=http://localhost:8080

# Production (set this on Vercel to your Render/EC2 backend URL)
# VITE_API_URL=https://lumenai-backend.onrender.com
